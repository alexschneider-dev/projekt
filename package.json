{
  "name": "projekt",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "analyze": "ANALYZE=true next build",
    "test:glob": "node --test testing/fast-glob.test.mjs",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --audit-level=low",
    "prebuild": "npm run audit:dependencies",
    "preanalyze": "npm run audit:dependencies",
    "auth:create-user": "node scripts/create-user.mjs",
    "test:auth": "node --experimental-strip-types --test testing/auth.test.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.0.0",
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/lib-storage": "^3.1091.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "6.12.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "redis": "^6.1.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14",
    "fast-glob": "file:./tools/fast-glob",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "prisma": "6.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "fast-glob": "$fast-glob",
    "prisma": "$prisma",
    "@prisma/client": "$@prisma/client",
    "dotenv": "$dotenv"
  },
  "workspaces": [
    "services/migration"
  ]
}
