# Lokale Image-Version.
MARKETPLACE_DEV_VERSION=1.00
# Dasselbe Anwendungspasswort in DATABASE_URL einsetzen.
MARKETPLACE_DATABASE_PASSWORD=
# Eigener Benutzer und eigenes Schema in der gemeinsamen Datenbank.
DATABASE_URL=postgresql://marketplace_app:PASSWORT@localhost:5432/postgres?schema=marketplace
NEXT_PUBLIC_BASE_PATH=/marketplace
NEXTAUTH_URL=https://localhost/marketplace/api/auth
NEXTAUTH_SECRET=
RESEND_API_KEY=
MAIL_FROM=
TRUST_PROXY=false
OBSERVABILITY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=marketplace
METRICS_PORT=9465
# Niemals Zugangsdaten mit NEXT_PUBLIC_ veröffentlichen.
PEXELS_API_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Bestätigtes Budget aus dem verbleibenden Kontingent des GESAMTEN R2-Kontos.
R2_IMAGE_BUDGET_BYTES=200000000
