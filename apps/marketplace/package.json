{
  "name": "marketplace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "predev": "prisma generate",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest run && node --test testing/images.test.mjs && npm run websocket:test",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --audit-level=low",
    "prebuild": "npm run audit:dependencies",
    "db:migrate": "prisma migrate deploy",
    "data:seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "images:discover": "node --env-file-if-exists=.env.local scripts/images/discover.mjs",
    "images:review": "node scripts/images/review.mjs",
    "images:import": "node --env-file-if-exists=.env.local scripts/images/import.mjs",
    "auth:create-user": "node --env-file-if-exists=.env.local scripts/create-user.mjs",
    "images:assign": "node --env-file-if-exists=.env.local scripts/images/assign.mjs",
    "test:http": "node --env-file-if-exists=.env.local --test testing/http.test.mjs",
    "dev:services": "bash services/development/scripts/start.sh",
    "dev:stop": "bash services/development/scripts/stop.sh",
    "test:e2e": "playwright test",
    "test:db:up": "docker compose -f testing/compose.yml up -d --wait",
    "test:db:down": "docker compose -f testing/compose.yml down -v",
    "test:smoke": "node scripts/smoke.mjs",
    "websocket:start": "npm run start --workspace marketplace-websocket",
    "websocket:test": "npm run test --workspace marketplace-websocket",
    "websocket:test:integration": "npm run test:integration --workspace marketplace-websocket"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/client": "6.12.0",
    "@prisma/instrumentation": "^6.12.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/otel": "^2.1.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "17.2.3",
    "fast-glob": "file:./tools/fast-glob",
    "ioredis": "^6.1.0",
    "lucide-react": "^1.33.0",
    "next": "^16.4.3",
    "next-auth": "^4.24.14",
    "pg": "^8.22.0",
    "picomatch": "file:./tools/picomatch-secure",
    "prom-client": "^15.1.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "sharp": "^0.35.3",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.3",
    "jsdom": "^30.1.3",
    "minimatch": "file:./tools/minimatch-compat",
    "prisma": "6.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "$minimatch",
    "fast-glob": "$fast-glob",
    "prisma": "$prisma",
    "@prisma/client": "$@prisma/client",
    "dotenv": "$dotenv",
    "picomatch": "$picomatch"
  },
  "workspaces": [
    "services/websocket"
  ]
}
