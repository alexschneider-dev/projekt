model Seller {
  id     String  @id @default(cuid())
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id])
  name   String
  slug   String  @unique
  offers Offer[]
}

model Offer {
  id           String  @id
  sellerId     String
  seller       Seller  @relation(fields: [sellerId], references: [id])
  productId    Int
  product      Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceCents   Int
  stock        Int     @default(0)
  deliveryDays Int     @default(3)
  active       Boolean @default(true)
  cartItems    CartItem[]

  @@unique([sellerId, productId])
  @@unique([id, productId])
  @@index([productId, active, priceCents])
  @@index([sellerId, active, productId])
  @@index([active, priceCents, productId])
}
