FROM node:22-alpine3.24 AS base

RUN apk upgrade --no-cache && apk add --no-cache curl openssl

FROM base AS dev
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

RUN adduser -S -u 1001 -G node nextjs
RUN mkdir -p /app/.next/cache/images && chown -R nextjs:node /app/.next/cache

COPY tools/fast-glob ./tools/fast-glob
COPY tools/minimatch-compat ./tools/minimatch-compat
COPY tools/picomatch-secure ./tools/picomatch-secure
COPY package.json package-lock.json ./
COPY services/migration/package.json ./services/migration/package.json

RUN npm ci --no-audit

COPY . .

RUN npx prisma generate \
  && chown -R nextjs:node /app/node_modules/.prisma

USER nextjs

CMD ["npm", "run", "dev"]
