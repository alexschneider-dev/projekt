FROM node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends curl && apt-get clean

FROM base AS dev
WORKDIR /app

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

RUN adduser --system --uid 1001 --ingroup node nextjs
RUN mkdir -p /app/.next/cache/images && chown -R nextjs:node /app/.next/cache

COPY tools/fast-glob ./tools/fast-glob
COPY package.json package-lock.json ./
COPY services/migration/package.json ./services/migration/package.json

RUN npm ci --no-audit

COPY . .

RUN npx prisma generate

USER nextjs

CMD ["npm", "run", "dev"]
