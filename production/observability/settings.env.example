# Als /etc/projekt/observability.env speichern: root:root, Modus 0600.
# Nur vertrauenswürdige Administratoren dürfen diese Shell-Datei bearbeiten.
OBS_SECRET_REVISION=r1
GRAFANA_ROOT_URL=https://alex-schneider-dev.de/grafana/
SMTP_HOST=REPLACE_WITH_SMTP_HOST:587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_FROM=REPLACE_WITH_SMTP_FROM
ALERT_EMAIL_TO=REPLACE_WITH_ALERT_EMAIL
LOKI_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
LOKI_S3_ENDPOINT=https://REPLACE_WITH_S3_ENDPOINT
LOKI_S3_REGION=REPLACE_WITH_S3_REGION
AWS_CLI_IMAGE=amazon/aws-cli:2.31.18
