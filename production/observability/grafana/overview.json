{
  "uid": "projekt-production",
  "title": "Projekt – Betrieb und Diagnose",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "production"
  ],
  "panels": [
    {
      "id": 101,
      "title": "Letzte Logs — $service",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 11
      },
      "description": "Dienstauswahl oben; neueste 200 Einträge zuerst. Aktualisierung jede Minute.",
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=~\"${service:regex}\"}",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "title": "Fehler / Exceptions — $service",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 11
      },
      "description": "Fehler nach explizitem Log-Level, Browser-Exception oder Fehlerpräfix. Keine Volltextsuche nach dem Wort error; unstrukturierte Meldungen ohne diese Merkmale können fehlen. Klassifizierte Abbrüche und Scheduler-EOF stehen separat unter „Abfrageabbrüche / Scheduler-Diagnose“; Originalmeldungen bleiben erhalten.",
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=~\"${service:regex}\",query_event!~\"canceled|scheduler_stream_closed|response_peer_closed\"} |~ \"(?i)(^|[ ,])level=(error|fatal|panic)([ ,]|$)|\\\"level\\\"\\\\s*:\\\\s*\\\"(error|fatal|panic)\\\"|\\\"kind\\\"\\\\s*:\\\\s*\\\"exception\\\"|\\\\[(error|crit|alert|emerg)\\\\]|^(Error:|TypeError:|ReferenceError:|SyntaxError:|Unhandled|Traceback|panic:|FATAL|ERROR)\"",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 107,
      "title": "Browserfehler — JavaScript / Promise / Error Boundary",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 10
      },
      "description": "Browserfehler und unbehandelte Promise-Ablehnungen. URLs werden vor dem Versand entfernt; Web Vitals stehen separat. Keine automatische Auflösung minifizierter Frames.",
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=\"browser\"} | json | __error__=\"\" | kind=\"exception\"",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 103,
      "title": "HTTP 5xx — URL-Filter",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 9
      },
      "description": "Serverfehler aus Nginx. Unabhängig von der Dienstauswahl; berücksichtigt das URL-Präfix.",
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json | __error__=\"\" | path=~\"${url:regex}.*\" | status >= 500",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "title": "Requests je URL — Top 20 im Zeitraum",
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "description": "Anzahl im gewählten Zeitraum. Nginx inklusive Cache-Hits und statischer Dateien, keine eindeutigen Besucher. URL-Präfix filtert; Dienstauswahl gilt hier nicht.",
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (path) (count_over_time({environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json path=\"path\" | __error__=\"\" | path=~\"${url:regex}.*\" | keep path [$__range])))",
          "queryType": "instant",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "{{path}}",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Anzahl",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "path": "URL-Pfad",
              "Value": "Anzahl"
            }
          }
        }
      ]
    },
    {
      "id": 105,
      "title": "Requests pro Minute — URL-Filter",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 10
      },
      "description": "Rollierende Anzahl der Nginx-Requests in einer Minute für alle zum URL-Präfix passenden Pfade.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json path=\"path\" | __error__=\"\" | path=~\"${url:regex}.*\" | keep service_name [1m]))",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "Requests / Minute"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 106,
      "title": "Letzte HTTP-Anfragen — URL-Filter",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      },
      "description": "Alle Statuscodes, neueste 200 Requests zuerst. Pfad, Methode, Status und request_time durch Aufklappen sichtbar.",
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json | __error__=\"\" | path=~\"${url:regex}.*\"",
          "queryType": "range",
          "direction": "backward",
          "maxLines": 200,
          "legendFormat": "{{path}}"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 1,
      "title": "Anfragen pro Sekunde",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route)(rate(app_http_request_duration_seconds_count[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Anteil HTTP 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(app_http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) or (0 * sum(rate(app_http_request_duration_seconds_count[5m])))) / (sum(rate(app_http_request_duration_seconds_count[5m])) > 0)",
          "legendFormat": "{{route}}{{service}}{{job}}{{instance}}{{quantile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Next.js-App-Metriken. 0 bei Requests ohne 5xx; keine Daten ohne Traffic/Metriken. Nginx-/Grafana-502 stehen separat im HTTP-5xx-Logpanel."
    },
    {
      "id": 3,
      "title": "Latenz p50 nach Route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by(le, route)(rate(app_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Histogramm-Schätzung über 5 Minuten; bei wenigen Requests und breiten Buckets ungenau."
    },
    {
      "id": 4,
      "title": "Latenz p95 nach Route",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
