    {
      "id": 28,
      "title": "Nginx p95 nach Anfragekategorie",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 153,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.95, {environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json request_time=\"request_time\", request_path=\"path\", response_status=\"status\" | response_status != 101 | request_path !~ \"^/(socket[.]io|grafana)(/.*)?$\" | request_path != \"/collect\" | request_path != \"/observability-health\" | unwrap request_time | __error__=\"\" [5m]) by (service_name)",
          "legendFormat": "Shop"
        },
        {
          "refId": "B",
          "expr": "quantile_over_time(0.95, {environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json request_time=\"request_time\", request_path=\"path\", response_status=\"status\" | response_status != 101 | request_path =~ \"^/socket[.]io(/.*)?$\" | unwrap request_time | __error__=\"\" [5m]) by (service_name)",
          "legendFormat": "Sockets"
        },
        {
          "refId": "C",
          "expr": "quantile_over_time(0.95, {environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json request_time=\"request_time\", request_path=\"path\", response_status=\"status\" | response_status != 101 | request_path =~ \"^/(grafana(/.*)?|collect|observability-health)$\" | unwrap request_time | __error__=\"\" [5m]) by (service_name)",
          "legendFormat": "Monitoring"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "5-Minuten-p95 der HTTP-Laufzeit (einschließlich Upload/Download). Status 101 ausgeschlossen: WebSocket-Verbindungsdauer ist keine Antwortlatenz. Monitoring wird getrennt angezeigt."
    },
    {
      "id": 108,
      "title": "Langsame Nginx-Anfragen (≥5s)",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 161,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{environment=\"production\",service_name=\"nginx\",log_type=\"access\"} | json | status != 101 | request_time >= 5 | __error__=\"\"",
          "queryType": "range",
          "maxLines": 200
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "description": "HTTP-Requests ab 5 Sekunden, ohne WebSocket-Upgrades (101). Aufklappen: path, status, request_time, upstream_time. Socket-Polling kann absichtlich lange offen bleiben; upstream_time enthält bei Retries mehrere Werte."
    },
    {
      "id": 109,
