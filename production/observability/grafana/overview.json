        }
      },
      "description": "Histogramm-Schätzung über 5 Minuten; bei wenigen Requests und breiten Buckets ungenau."
    },
    {
      "id": 6,
      "title": "Anfragen im Zeitraum",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 65,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(route)(increase(app_http_request_duration_seconds_count[5m]))",
