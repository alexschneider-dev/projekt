generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InternalRole {
  USER
  SUPER_ADMIN
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  passwordHash   String
  role           InternalRole    @default(USER)
  active         Boolean         @default(true)
  sessionVersion Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  jobs           JobListing[]
  searches       JobSearch[]
  importState    JobImportState?
}

model PendingRegistration {
  email        String   @id
  passwordHash String
  tokenHash    String   @unique
  expiresAt    DateTime

  @@index([expiresAt])
}

model LoginAttempt {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

enum JobStatus {
  PENDING
  BEWORBEN
  NICHT_PASSEND
  AUSGELAUFEN
}

model JobListing {
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  id         Int      @id @default(autoincrement())
  url        String
  createdAt  DateTime @default(now())
  status     JobStatus @default(PENDING)

  @@unique([userId, url])
  @@index([userId, createdAt, id])
}

model JobSearch {
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  id               Int       @id @default(autoincrement())
  url              String
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  title            String    @default("Gespeicherte Suche")
  lastResultCount  Int?
  lastFetchedAt    DateTime?
  lastScannedPages Int?
  lastTotalPages   Int?
  lastScannedCount Int?
  lastScanComplete Boolean?

  @@unique([userId, url])
}

model JobImportState {
  id            Int       @id @default(autoincrement())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  requested     Boolean   @default(false)
  running       Boolean   @default(false)
  stopRequested Boolean   @default(false)
  stopped       Boolean   @default(false)
  requestedAt   DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  succeeded     Boolean?
  inserted      Int       @default(0)
}
