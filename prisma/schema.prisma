generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum InternalRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String
  role           InternalRole @default(USER)
  active         Boolean      @default(true)
  sessionVersion Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model LoginAttempt {
  key       String   @id
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}
